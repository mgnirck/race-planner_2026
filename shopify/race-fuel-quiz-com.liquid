{% comment %}
  Lecka Race Fuel Quiz — race-fuel-quiz.liquid
  =============================================
  A short "What's your next race?" quiz: a carb plan per hour with Lecka
  products, a simple drink & salt line, and a ready-to-buy Lecka kit that
  goes straight to checkout.

  getlecka.com version: English only, US store packs and prices in USD.

  Install (2 minutes):
    1. Online Store → Themes → … → Edit code → Sections → Add a new section
       → name it "race-fuel-quiz-com" → replace everything with this file → Save.
    2. Customize → Add section → "Race Fuel Quiz" → drag it under the hero.
       The heading and text above the quiz are edited there (and translated
       in Translate & Adapt like any other section).
    3. Discounts → Create discount → Amount off order → code RACEKIT5, 5 %
       (or change the code in the section settings; leave it empty for none).

  Self-contained: no app, no iframe. Prices, stock, product names and images
  are read live from the store (collections.all). Only variant IDs and
  nutrition values live in the script below — nutrition per unit comes from
  the Lecka product master (lecka-portal/content/products).
  Formulas mirror lecka-race-planner/src/engine/nutrition-engine.js
  (distance_adaptive carbs with the elevation modifier, sodium = fluid ×
  concentration) with the full planner's defaults: 70 kg, intermediate
  athlete, and the race-day climate set in the store block (warm). lecka-race-planner/scripts/test-race-quiz.mjs
  checks that both give the same numbers.
  Always English.

  This file is for getlecka.com; race-fuel-quiz.liquid is the same quiz for
  getlecka.vn. Only the store block in the script (/* store:start */), the
  language lines, this comment and the settings defaults differ; the test
  checks that the rest stays identical, so change both files together.
{% endcomment %}

{%- liquid
  assign sid = section.id
  assign lang = 'en'
-%}

<style>
  #lrq-{{ sid }} {
    --lrq-bg: {{ section.settings.color_bg }};
    --lrq-card: {{ section.settings.color_card }};
    --lrq-text: {{ section.settings.color_text }};
    --lrq-accent: {{ section.settings.color_accent }};
    --lrq-btn: {{ section.settings.color_button }};
    --lrq-btn-text: {{ section.settings.color_button_text }};
    --lrq-muted: color-mix(in srgb, var(--lrq-text) 60%, transparent);
    --lrq-line: color-mix(in srgb, var(--lrq-text) 12%, transparent);
    --lrq-tint: color-mix(in srgb, var(--lrq-accent) 12%, transparent);
    background: var(--lrq-bg);
    color: var(--lrq-text);
    padding: {{ section.settings.padding_top }}px 16px {{ section.settings.padding_bottom }}px;
  }
  #lrq-{{ sid }} * { box-sizing: border-box; }
  #lrq-{{ sid }} .lrq-header { max-width: 640px; margin: 0 auto 20px; text-align: {{ section.settings.heading_align }}; }
  #lrq-{{ sid }} .lrq-header h2 {
    font-size: clamp(26px, 7vw, {{ section.settings.heading_size }}px); line-height: 1.15; margin: 0 0 8px; color: var(--lrq-text);
  }
  #lrq-{{ sid }} .lrq-header .lrq-hsub { font-size: 16px; color: var(--lrq-muted); margin: 0; }
  #lrq-{{ sid }} .lrq-card {
    max-width: 640px; margin: 0 auto; background: var(--lrq-card);
    border-radius: 20px; padding: 24px 20px; box-shadow: 0 6px 30px rgba(0,0,0,.06);
  }
  #lrq-{{ sid }} .lrq-eyebrow {
    display: flex; justify-content: space-between; align-items: center; gap: 12px;
    font-size: 12px; letter-spacing: .08em; text-transform: uppercase;
    color: var(--lrq-accent); font-weight: 700; margin: 0 0 8px;
  }
  #lrq-{{ sid }} .lrq-dots { display: flex; gap: 6px; flex: none; }
  #lrq-{{ sid }} .lrq-dots i { width: 22px; height: 4px; border-radius: 4px; background: var(--lrq-line); }
  #lrq-{{ sid }} .lrq-dots i.on { background: var(--lrq-accent); }
  #lrq-{{ sid }} .lrq-q { font-size: clamp(22px, 6vw, 30px); line-height: 1.15; margin: 0 0 6px; color: var(--lrq-text); }
  #lrq-{{ sid }} .lrq-sub { color: var(--lrq-muted); margin: 0 0 18px; font-size: 15px; }
  #lrq-{{ sid }} .lrq-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  #lrq-{{ sid }} .lrq-grid.one { grid-template-columns: 1fr; }
  @media (min-width: 560px) { #lrq-{{ sid }} .lrq-grid.three { grid-template-columns: 1fr 1fr 1fr; } }
  #lrq-{{ sid }} .lrq-chip {
    appearance: none; border: 2px solid var(--lrq-line); background: transparent; color: var(--lrq-text);
    border-radius: 14px; padding: 14px; min-height: 64px; text-align: left; cursor: pointer;
    font: inherit; display: flex; flex-direction: column; justify-content: center; gap: 2px;
    transition: border-color .15s, background .15s, transform .1s;
  }
  #lrq-{{ sid }} .lrq-chip:hover { border-color: var(--lrq-accent); }
  #lrq-{{ sid }} .lrq-chip:active { transform: scale(.98); }
  #lrq-{{ sid }} .lrq-chip.on { border-color: var(--lrq-accent); background: var(--lrq-tint); }
  #lrq-{{ sid }} .lrq-chip b { font-size: 16px; }
  #lrq-{{ sid }} .lrq-chip small { font-size: 13px; color: var(--lrq-muted); }
  #lrq-{{ sid }} .lrq-panel { margin: 14px 0 0; display: grid; gap: 12px; }
  #lrq-{{ sid }} .lrq-field label { display: block; font-size: 14px; font-weight: 600; margin: 0 0 6px; }
  #lrq-{{ sid }} .lrq-input { display: flex; align-items: center; gap: 8px; }
  #lrq-{{ sid }} .lrq-input input {
    width: 110px; font: inherit; font-size: 18px; padding: 10px 12px; border-radius: 12px;
    border: 2px solid var(--lrq-line); background: transparent; color: var(--lrq-text);
  }
  #lrq-{{ sid }} .lrq-input input.short { width: 76px; }
  #lrq-{{ sid }} .lrq-input input:focus { outline: none; border-color: var(--lrq-accent); }
  #lrq-{{ sid }} .lrq-input span { color: var(--lrq-muted); font-size: 15px; }
  #lrq-{{ sid }} .lrq-check {
    display: flex; gap: 12px; align-items: flex-start; border: 2px solid var(--lrq-line); border-radius: 14px;
    padding: 12px 14px; cursor: pointer;
  }
  #lrq-{{ sid }} .lrq-check.on { border-color: var(--lrq-accent); background: var(--lrq-tint); }
  #lrq-{{ sid }} .lrq-check input { width: 22px; height: 22px; margin: 1px 0 0; accent-color: var(--lrq-accent); flex: none; }
  #lrq-{{ sid }} .lrq-check b { display: block; font-size: 15px; }
  #lrq-{{ sid }} .lrq-check small { font-size: 13px; color: var(--lrq-muted); }
  #lrq-{{ sid }} .lrq-hint { font-size: 13px; color: #c0392b; margin: 6px 0 0; }
  #lrq-{{ sid }} .lrq-next { margin: 16px 0 0; }
  #lrq-{{ sid }} .lrq-back {
    appearance: none; background: none; border: 0; color: var(--lrq-muted); font: inherit;
    font-size: 14px; padding: 12px 0 0; cursor: pointer; text-decoration: underline;
  }
  #lrq-{{ sid }} .lrq-assume { font-size: 13px; color: var(--lrq-muted); margin: 0 0 14px; display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; }
  #lrq-{{ sid }} .lrq-time { display: inline-flex; align-items: center; gap: 6px; }
  #lrq-{{ sid }} .lrq-time button {
    appearance: none; width: 32px; height: 32px; border-radius: 50%; border: 2px solid var(--lrq-line);
    background: transparent; color: var(--lrq-text); font: inherit; font-size: 18px; line-height: 1; cursor: pointer;
  }
  #lrq-{{ sid }} .lrq-time strong { font-size: 15px; color: var(--lrq-text); min-width: 44px; text-align: center; }
  #lrq-{{ sid }} .lrq-hero { border-radius: 16px; padding: 18px 16px; background: var(--lrq-tint); text-align: center; margin: 0 0 16px; }
  #lrq-{{ sid }} .lrq-hero b { display: block; font-size: clamp(40px, 12vw, 56px); line-height: 1; }
  #lrq-{{ sid }} .lrq-hero b small { font-size: .45em; }
  #lrq-{{ sid }} .lrq-hero span { display: block; font-size: 15px; font-weight: 600; margin: 4px 0 0; }
  #lrq-{{ sid }} .lrq-hero p { font-size: 14px; color: var(--lrq-muted); margin: 6px 0 0; }
  #lrq-{{ sid }} h4 { font-size: 18px; margin: 0 0 10px; color: var(--lrq-text); }
  #lrq-{{ sid }} .lrq-hours { list-style: none; margin: 0 0 10px; padding: 0; }
  #lrq-{{ sid }} .lrq-hours li { display: grid; grid-template-columns: 86px 1fr auto; gap: 10px; align-items: center; padding: 9px 0; border-bottom: 1px solid var(--lrq-line); font-size: 14px; }
  #lrq-{{ sid }} .lrq-hours .h { color: var(--lrq-muted); font-variant-numeric: tabular-nums; }
  #lrq-{{ sid }} .lrq-hours .g { font-weight: 700; font-variant-numeric: tabular-nums; }
  #lrq-{{ sid }} .lrq-tips { margin: 0 0 18px; padding: 0 0 0 18px; font-size: 14px; }
  #lrq-{{ sid }} .lrq-tips li { margin: 4px 0; }
  #lrq-{{ sid }} .lrq-drink { border: 1px solid var(--lrq-line); border-radius: 14px; padding: 12px 14px; margin: 0 0 20px; font-size: 14px; }
  #lrq-{{ sid }} .lrq-drink b { display: block; margin: 0 0 4px; font-size: 15px; }
  #lrq-{{ sid }} .lrq-drink p { margin: 0; }
  #lrq-{{ sid }} .lrq-tabs { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin: 0 0 12px; }
  #lrq-{{ sid }} .lrq-tabs .lrq-chip { min-height: 56px; padding: 10px 12px; }
  #lrq-{{ sid }} .lrq-items { list-style: none; margin: 0 0 12px; padding: 0; }
  #lrq-{{ sid }} .lrq-items li { display: flex; align-items: center; gap: 12px; padding: 8px 0; border-bottom: 1px solid var(--lrq-line); font-size: 14px; }
  #lrq-{{ sid }} .lrq-items img { width: 48px; height: 48px; object-fit: contain; border-radius: 8px; background: #fff; flex: none; }
  #lrq-{{ sid }} .lrq-items .n { flex: 1; }
  #lrq-{{ sid }} .lrq-items .n small { display: block; color: var(--lrq-muted); }
  #lrq-{{ sid }} .lrq-total { display: flex; justify-content: space-between; align-items: baseline; font-size: 15px; margin: 4px 0; }
  #lrq-{{ sid }} .lrq-total.big { font-size: 20px; font-weight: 700; }
  #lrq-{{ sid }} .lrq-note { font-size: 13px; color: var(--lrq-muted); margin: 6px 0 0; }
  #lrq-{{ sid }} .lrq-ship { font-size: 14px; margin: 8px 0 14px; color: var(--lrq-accent); font-weight: 600; }
  #lrq-{{ sid }} .lrq-cta {
    appearance: none; display: block; width: 100%; border: 0; border-radius: 999px; padding: 17px 20px;
    background: var(--lrq-btn); color: var(--lrq-btn-text); font: inherit; font-size: 17px; font-weight: 700;
    cursor: pointer; text-align: center; text-decoration: none;
  }
  #lrq-{{ sid }} .lrq-cta[disabled] { opacity: .4; cursor: not-allowed; }
  #lrq-{{ sid }} .lrq-cta.busy { opacity: .6; cursor: wait; }
  #lrq-{{ sid }} .lrq-links { display: flex; flex-direction: column; align-items: center; gap: 10px; margin: 14px 0 0; }
  #lrq-{{ sid }} .lrq-links button {
    appearance: none; background: none; border: 0; font: inherit; font-size: 15px; color: var(--lrq-text);
    text-decoration: underline; cursor: pointer; padding: 4px;
  }
  #lrq-{{ sid }} .lrq-plan { margin: 22px 0 0; border-radius: 16px; padding: 16px; border: 2px solid var(--lrq-accent); }
  #lrq-{{ sid }} .lrq-plan b { display: block; font-size: 16px; margin: 0 0 4px; }
  #lrq-{{ sid }} .lrq-plan p { font-size: 14px; color: var(--lrq-muted); margin: 0 0 12px; }
  #lrq-{{ sid }} .lrq-plan a {
    display: block; text-align: center; border-radius: 999px; padding: 13px 16px; font-weight: 700; font-size: 15px;
    background: var(--lrq-accent); color: #fff; text-decoration: none;
  }
  #lrq-{{ sid }} .lrq-err { color: #c0392b; font-size: 14px; margin: 8px 0 0; text-align: center; }
  #lrq-{{ sid }} .lrq-fine { font-size: 12px; color: var(--lrq-muted); margin: 16px 0 0; text-align: center; }
  #lrq-{{ sid }} [hidden] { display: none !important; }
</style>

<section id="lrq-{{ sid }}" class="lrq" data-lang="{{ lang }}">
  {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
    <div class="lrq-header">
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.subheading != blank -%}<p class="lrq-hsub">{{ section.settings.subheading }}</p>{%- endif -%}
    </div>
  {%- endif -%}
  <div class="lrq-card" aria-live="polite"><div data-lrq-root></div></div>
</section>

{%- comment -%}
  Live store data for every variant: price (in 1/100 of the currency unit,
  as Liquid gives it), stock, product title in the visitor's language, image.
{%- endcomment -%}
<script type="application/json" id="lrq-data-{{ sid }}">
{
  "variants": {
    {%- for product in collections.all.products -%}
      {%- for v in product.variants -%}
        "{{ v.id }}": {
          "p": {{ v.price }},
          "a": {{ v.available | json }},
          "t": {{ product.title | json }},
          "i": {%- if product.featured_image -%}{{ product.featured_image | image_url: width: 160 | json }}{%- else -%}null{%- endif -%}
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
      {%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  },
  "cartTotal": {{ cart.total_price | default: 0 }},
  "currency": {{ cart.currency.iso_code | json }},
  "cartAdd": {{ routes.cart_add_url | json }},
  "cartUrl": {{ routes.cart_url | json }},
  "settings": {
    "discountCode": {{ section.settings.discount_code | strip | json }},
    "discountPct": {{ section.settings.discount_percent | default: 0 }},
    "freeShipping": {{ section.settings.free_shipping_threshold | default: 0 }},
    "defaultKit": {{ section.settings.default_kit | json }},
    "plannerUrl": {{ section.settings.planner_url | strip | json }},
    "region": {{ section.settings.region | json }}
  }
}
</script>

