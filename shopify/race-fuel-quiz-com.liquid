    var km = distKm(), elev = elevM();
    var h = head(2, t('q2'), t('q2sub')) + '<div class="lrq-grid one three">' + CALC.GOALS.map(function (g, i) {
      return chip('goal', g, t('goal_' + g), t('goal_' + g + '_s') + ' · ~' + hm(CALC.estimateMinutes(st.kind, km, elev, i)), st.goal === g);
    }).join('') + '</div>';
    if (st.goal) {
      var bad = !(typedMinutes() >= 5 && typedMinutes() <= 6000);
      h += '<div class="lrq-panel"><div class="lrq-field"><label for="lrq-' + SID + '-timeH">' + esc(t('timeLabel')) + '</label>' +
        '<div class="lrq-input"><input id="lrq-' + SID + '-timeH" class="short" type="number" inputmode="numeric" min="0" max="99" data-f="timeH" value="' + esc(st.timeH) + '"><span>' + esc(t('h')) + '</span>' +
        '<input class="short" type="number" inputmode="numeric" min="0" max="59" data-f="timeM" aria-label="' + esc(t('min')) + '" value="' + esc(st.timeM) + '"><span>' + esc(t('min')) + '</span></div>' +
        '<p class="lrq-hint" data-hint="time"' + (bad ? '' : ' hidden') + '>' + esc(t('timeErr')) + '</p></div></div>';
    }
    return h + next('next2', step2Ok()) + back();
  }

  function renderStep3() {
    return head(3, t('q3'), t('q3sub')) + '<div class="lrq-grid">' + ['light', 'average', 'salty', 'unsure'].map(function (s) {
      return chip('sweat', s, t('sweat_' + s), t('sweat_' + s + '_s'), st.sweat === s);
    }).join('') + '</div>' + back();
  }

  function unitsText(row) {
    var parts = [];
    [['gel', row.gel], ['ultra', row.ultra], ['bar', row.bar]].forEach(function (p) {
      if (p[1]) parts.push(p[1] + ' ' + t('x') + ' ' + t(p[0]));
    });
    return parts.join(t('plus'));
  }

  function renderResult() {
    var sweat = st.sweat === 'unsure' ? 'average' : st.sweat;
    var r = race(), km = distKm(), elev = elevM();
    var tg = CALC.targets(r, st.goal, st.minutes, sweat, km, elev);
    var units = CALC.raceUnits(r, tg, st.minutes);
    var raceKit = CALC.buildKit(units, 1, st.minutes, live);
    var kit = st.kit === 'training' ? CALC.buildKit(units, 3, st.minutes, live) : raceKit;
    st.lines = kit.lines;
    var nUnits = units.gel + units.ultra + units.bar;

    // Carb strategy
    var plan;
    if (st.minutes < 60) {
      plan = '<p class="lrq-how">' + esc(t('shortRace')) + '</p>';
    } else {
      var rows = CALC.schedule(units, tg.hours), long = rows.length > 10;
      plan = '<ul class="lrq-hours">' + (long ? rows.slice(0, 4) : rows).map(function (row) {
        return '<li><span class="h">' + esc(t('hour', { from: hm(row.from), to: hm(row.to) })) + '</span>' +
          '<span>' + esc(unitsText(row)) + '</span><span class="g">' + row.carbs + ' g</span></li>';
      }).join('') + (long ? '<li><span class="h">' + esc(hm(240)) + '–' + esc(hm(st.minutes)) + '</span>' +
        '<span>' + esc(t('repeat')) + '</span><span class="g">' + tg.carbH + ' g/h</span></li>' : '') + '</ul>';
      var tips = [t('tipStart')];
      if (units.bar) tips.push(t('tipBars'));
      if (st.minutes >= 90 && units.gel) tips.push(t('tipCoffee'));
      tips.push(t('tipWater'));
      plan += '<ul class="lrq-tips">' + tips.map(function (x) { return '<li>' + esc(x) + '</li>'; }).join('') + '</ul>';
    }

    // Drink & salt
    var gotH = Math.round(CALC.sodiumCovered(units) / tg.hours / 10) * 10;
    var drink = '<div class="lrq-drink"><b>' + esc(t('drinkTitle')) + '</b><p>' +
      esc(t('drinkBody', { ml: num(Math.round(tg.fluidH / 50) * 50), na: num(Math.round(tg.naH / 10) * 10) })) + ' ' +
      esc(gotH >= tg.naH * 0.95 ? t('drinkFull') : t('drinkGap', { got: num(gotH) })) + '</p></div>';

    var items = kit.lines.map(function (l) {
      var d = live(l.v), title = d && d.t ? d.t : l.name;
      var sub = l.units !== l.qty ? l.units + ' ' + t('pcs') : '';
      return '<li>' + (d && d.i ? '<img src="' + esc(d.i) + '" alt="" loading="lazy" width="48" height="48">' : '') +
        '<span class="n">' + l.qty + ' ' + t('x') + ' ' + esc(title) + (sub ? '<small>' + esc(sub) + '</small>' : '') + '</span>' +
        '<span>' + money(l.qty * l.price) + '</span></li>';
    }).join('');

    var pctOff = S.discountCode && S.discountPct > 0 ? S.discountPct : 0;
    var pay = kit.total * (1 - pctOff / 100);
    var ship = '';
    if (S.freeShipping > 0) {
      var left = S.freeShipping - (DATA.cartTotal / 100 + pay);
      ship = '<p class="lrq-ship">' + esc(left <= 0 ? t('shipFree') : t('shipMore', { amt: money(left) })) + '</p>';
    }

    return '<p class="lrq-eyebrow"><span>' + esc(t('eyebrow')) + '</span>' + dots(3) + '</p>' +
      '<h3 class="lrq-q">' + esc(t('result', { race: raceName() })) + '</h3>' +
      '<div class="lrq-assume"><span class="lrq-time">' + esc(t('finish')) +
        ' <button type="button" data-a="time" data-v="-1" aria-label="−">−</button><strong>' + hm(st.minutes) +
        '</strong><button type="button" data-a="time" data-v="1" aria-label="+">+</button></span>' +
        '<span>' + esc(t('goal_' + st.goal)) + ' · ' + esc(t('climate_' + CALC.CLIMATE)) + '</span></div>' +
      '<div class="lrq-hero"><b>' + tg.carbH + '<small> g</small></b><span>' + esc(t('carbsH')) + '</span>' +
        '<p>' + esc(t('carbsTotal', { carbs: num(tg.carbs), time: hm(st.minutes), n: nUnits })) + '</p></div>' +
      '<h4>' + esc(t('strategy')) + '</h4>' + plan + drink +
      '<h4>' + esc(t('kitTitle')) + '</h4>' +
      '<div class="lrq-tabs">' +
        chip('kit', 'race', t('kitRace'), t('kitRace_s', { n: raceKit.units }), st.kit === 'race') +
        chip('kit', 'training', t('kitTrain'), t('kitTrain_s'), st.kit === 'training') +
      '</div>' +
      '<ul class="lrq-items">' + items + '</ul>' +
      (kit.spare ? '<p class="lrq-note">+ ' + esc(t('spare', { n: kit.spare })) + '</p>' : '') +
      '<div class="lrq-total' + (pctOff ? '' : ' big') + '"><span>' + esc(t('subtotal')) + '</span><span>' + money(kit.total) + '</span></div>' +
      (pctOff ? '<div class="lrq-total big"><span>' + esc(t('youPay')) + '</span><span>' + money(pay) + '</span></div>' +
        '<p class="lrq-note" style="margin:0">' + esc(t('youPayNote', { pct: pctOff, code: S.discountCode })) + '</p>' : '') +
      ship +
      '<button type="button" class="lrq-cta" data-a="checkout">' + esc(t('cta')) + '</button>' +
      '<p class="lrq-err" data-lrq-err hidden>' + esc(t('err')) + '</p>' +
      '<div class="lrq-links"><button type="button" data-a="cart">' + esc(t('cartOnly')) + '</button></div>' +
      (S.plannerUrl ? '<div class="lrq-plan"><b>' + esc(t('planTitle')) + '</b><p>' + esc(t('planBody')) + '</p>' +
        '<a href="' + esc(plannerLink()) + '" target="_blank" rel="noopener" data-a="plan">' + esc(t('planCta')) + '</a></div>' : '') +
      '<p class="lrq-fine">' + esc(t('fine')) + '</p>' +
      back();
  }

  function render() {
    root.innerHTML = st.step === 1 ? renderStep1() : st.step === 2 ? renderStep2() : st.step === 3 ? renderStep3() : renderResult();
  }

  function plannerLink() {
    var q = Object.assign({ region: S.region, lang: LANG },
      CALC.plannerParams(st.kind, distKm(), st.trail, elevM(), st.minutes, st.goal, st.sweat),
      { utm_source: location.hostname, utm_medium: 'race_quiz', utm_campaign: st.kind });
    return S.plannerUrl.replace(/\/+$/, '') + '/planner/pro?' +
      Object.keys(q).map(function (k) { return k + '=' + encodeURIComponent(q[k]); }).join('&');
  }

  function addToCart(then) {
    var btns = root.querySelectorAll('[data-a="checkout"],[data-a="cart"]');
    btns.forEach(function (b) { b.disabled = true; });
    var cta = root.querySelector('[data-a="checkout"]');
    if (cta) { cta.textContent = t('ctaBusy'); cta.classList.add('busy'); }
    var note = raceName() + ' · ' + hm(st.minutes) + ' · ' + st.goal + (elevM() ? ' · +' + elevM() + ' m' : '') + ' · ' + (st.sweat || '');
    fetch(DATA.cartAdd + '.js', {
      method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ items: st.lines.map(function (l) { return { id: l.v, quantity: l.qty }; }) })
    }).then(function (r) {
      if (!r.ok) throw new Error('cart ' + r.status);
      return fetch(DATA.cartUrl + '/update.js', {
        method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ attributes: { 'Race quiz': note } })
      }).catch(function () {});
    }).then(then).catch(function () {
      btns.forEach(function (b) { b.disabled = false; });
      if (cta) { cta.textContent = t('cta'); cta.classList.remove('busy'); }
      var e = root.querySelector('[data-lrq-err]'); if (e) e.hidden = false;
    });
  }

  function go(path) {
    // /discount/CODE stores the code for checkout, then redirects
    var code = S.discountCode;
    location.href = code ? '/discount/' + encodeURIComponent(code) + '?redirect=' + encodeURIComponent(path) : path;
  }

  // Typing updates state and the Next button without re-rendering (keeps focus)
  root.addEventListener('input', function (e) {
    var f = e.target.getAttribute('data-f');
    if (!f || f === 'trail') return;
    st[f] = e.target.value;
    if (f === 'timeH' || f === 'timeM') st.timeEdited = true;
    var btn = root.querySelector('.lrq-next');
    if (st.step === 1) {
      if (btn) btn.disabled = !step1Ok();
      var hd = root.querySelector('[data-hint="' + f + '"]');
      if (hd) hd.hidden = f === 'elev' ? elevOk() : (st[f] === '' || distOk());
    } else if (st.step === 2) {
      if (btn) btn.disabled = !step2Ok();
      var ht = root.querySelector('[data-hint="time"]');
      var m = typedMinutes();
      if (ht) ht.hidden = m >= 5 && m <= 6000;
    }
  });
  root.addEventListener('change', function (e) {
    if (e.target.getAttribute('data-f') !== 'trail') return;
    st.trail = e.target.checked;
    render();
    if (st.trail) { var el = root.querySelector('[data-f="elev"]'); if (el) el.focus(); }
  });

  root.addEventListener('click', function (e) {
    var el = e.target.closest('[data-a]');
    if (!el || el.disabled) return;
    var a = el.getAttribute('data-a'), v = el.getAttribute('data-v');
    var focus = null;
    if (a === 'kind') {
      st.kind = v;
      if (v === 'custom') focus = 'customKm';
      if (v === 'triathlon_70_3') st.trail = false;
      st.goal = null; st.timeEdited = false;
    }
    else if (a === 'next1') { st.step = 2; track('race'); }
    else if (a === 'goal') {
      st.goal = v;
      if (!st.timeEdited) setTime(CALC.estimateMinutes(st.kind, distKm(), elevM(), CALC.GOALS.indexOf(v)));
    }
    else if (a === 'next2') { st.minutes = typedMinutes(); st.step = 3; }
    else if (a === 'sweat') { st.sweat = v; st.step = 4; track('result'); }
    else if (a === 'back') { st.step = Math.max(1, st.step - 1); }
    else if (a === 'time') {
      var step = st.minutes < 120 ? 5 : 15;
      setTime(Math.min(6000, Math.max(5, st.minutes + step * Number(v))));
      st.timeEdited = true;
    }
    else if (a === 'kit') { st.kit = v; track('kit'); }
    else if (a === 'checkout') { track('checkout'); addToCart(function () { go('/checkout'); }); return; }
    else if (a === 'cart') { track('add_to_cart'); addToCart(function () { go(DATA.cartUrl); }); return; }
    else if (a === 'plan') { track('full_plan'); return; }
    else return;
    render();
    if (focus) { var f = root.querySelector('[data-f="' + focus + '"]'); if (f) f.focus(); }
    if (a === 'next1' || a === 'next2' || a === 'sweat' || a === 'back') {
      if (host.getBoundingClientRect().top < 0) host.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  });

  render();
  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function (en) {
      if (en[0].isIntersecting) { track('view'); io.disconnect(); }
    }, { threshold: 0.4 });
    io.observe(host);
  }
})();
</script>

{% schema %}
{
  "name": "Race Fuel Quiz (.com)",
  "tag": "div",
  "class": "section-race-fuel-quiz",
  "settings": [
    { "type": "header", "content": "Header" },
    {
      "type": "inline_richtext", "id": "heading", "label": "Heading",
      "default": "Fuel your next race with real food",
      "info": "Leave empty to hide. Translate it in Translate & Adapt."
    },
    {
      "type": "inline_richtext", "id": "subheading", "label": "Text under the heading",
      "default": "Answer 3 quick questions and get your personal carb plan and Lecka race kit."
    },
    {
      "type": "select", "id": "heading_align", "label": "Alignment", "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ]
    },
    {
      "type": "range", "id": "heading_size", "label": "Heading size (desktop)",
      "min": 24, "max": 64, "step": 2, "unit": "px", "default": 40
    },
    { "type": "header", "content": "Checkout" },
    {
      "type": "text", "id": "discount_code", "label": "Discount code", "default": "RACEKIT5",
      "info": "Create this code under Discounts first. Leave empty for no discount."
    },
    {
      "type": "range", "id": "discount_percent", "label": "Discount shown in the quiz",
      "min": 0, "max": 30, "step": 1, "unit": "%", "default": 5,
      "info": "Only for display. The real discount is the code above."
    },
    {
      "type": "number", "id": "free_shipping_threshold", "label": "Free shipping from (store currency)",
      "default": 100, "info": "0 hides the free shipping line."
    },
    {
      "type": "select", "id": "default_kit", "label": "Kit selected first", "default": "race",
      "options": [
        { "value": "race", "label": "Race day" },
        { "value": "training", "label": "Race + 2 training runs" }
      ]
    },
    { "type": "header", "content": "Full planner link" },
    {
      "type": "text", "id": "planner_url", "label": "Planner URL", "default": "https://plan.getlecka.com",
      "info": "No trailing slash. Leave empty to hide the link."
    },
    {
      "type": "select", "id": "region", "label": "Planner region", "default": "us",
      "options": [
        { "value": "vn", "label": "Vietnam" },
        { "value": "us", "label": "United States" },
        { "value": "de", "label": "Germany" },
        { "value": "dk", "label": "Denmark" },
        { "value": "ch", "label": "Switzerland" }
      ]
    },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "color_bg", "label": "Section background", "default": "#F5F4F1" },
    { "type": "color", "id": "color_card", "label": "Card background", "default": "#FFFFFF" },
    { "type": "color", "id": "color_text", "label": "Text", "default": "#1B1B1B" },
    { "type": "color", "id": "color_accent", "label": "Accent", "default": "#48C4B0" },
    { "type": "color", "id": "color_button", "label": "Button", "default": "#1B1B1B" },
    { "type": "color", "id": "color_button_text", "label": "Button text", "default": "#FFFFFF" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom", "default": 40 }
  ],
  "presets": [{ "name": "Race Fuel Quiz (.com)" }]
}
{% endschema %}
