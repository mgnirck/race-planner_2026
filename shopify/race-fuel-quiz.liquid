  function interp(anchors, x) {
    if (x <= anchors[0][0]) return anchors[0][1];
    for (var i = 1; i < anchors.length; i++) {
      if (x <= anchors[i][0]) {
        var a = anchors[i - 1], b = anchors[i];
        return a[1] + (x - a[0]) / (b[0] - a[0]) * (b[1] - a[1]);
      }
    }
    return anchors[anchors.length - 1][1];
  }

  function targets(race, effort, minutes, sweat) {
    var dev = EFFORT_MOD[effort] - 1;
    var taper = minutes <= 240 ? 1 : Math.max(0.4, 1 - (minutes - 240) / 240 * 0.6);
    var carbH = Math.round(Math.round(interp(CARB_ANCHORS, minutes) * (1 + dev * taper)));
    var bikeContext = race === 'cycling' || race.indexOf('triathlon') === 0;
    var fluidH = Math.round(Math.min(Math.max(WEIGHT_KG * FLUID_PER_KG * HUMID, 400), bikeContext ? 1000 : 800));
    var naH = Math.round(Math.min(Math.max(fluidH / 1000 * SODIUM_PER_L[sweat || 'average'], 200), 1000));
    if (minutes < 90) naH = Math.round(naH * interp(SODIUM_SCALE, minutes));
    var h = minutes / 60;
    return { carbH: carbH, naH: naH, fluidH: fluidH, carbs: Math.round(carbH * h), sodium: Math.round(naH * h), hours: h };
  }

  // Units of each product type eaten on race day
  function raceUnits(race, tg) {
    var mix = MIX[race], avg = { gel: 25.4, ultra: 62.5, bar: 23.5 }, out = { gel: 0, ultra: 0, bar: 0 };
    Object.keys(mix).forEach(function (k) { out[k] = Math.ceil(tg.carbs * mix[k] / avg[k]); });
    if (out.gel + out.ultra + out.bar === 0) out.gel = 1;
    return out;
  }

  // Cheapest set of packs giving at least n units. packs: [{units, price}]
  function cheapest(n, packs) {
    var best = [{ cost: 0, use: null, prev: -1 }];
    for (var u = 1; u <= n; u++) {
      best[u] = null;
      packs.forEach(function (p, i) {
        var from = Math.max(0, u - p.units), c = best[from].cost + p.price;
        if (!best[u] || c < best[u].cost) best[u] = { cost: c, use: i, prev: from };
      });
    }
    var count = packs.map(function () { return 0; });
    for (var k = n; k > 0; k = best[k].prev) count[best[k].use]++;
    return count;
  }

  // live(v) → { p: price in currency units, a: available, t, i } or null
  function buildKit(race, units, multiplier, minutes, live) {
    var lines = {};
    function price(v) { var l = live(v); return l ? l.p : FALLBACK_PRICE[v]; }
    function ok(v) { var l = live(v); return !l || l.a; }
    function add(v, qty, unitsEach, name) {
      if (!qty) return;
      lines[v] = lines[v] || { v: v, qty: 0, units: 0, name: name };
      lines[v].qty += qty; lines[v].units += qty * unitsEach;
    }
    function rotate(list, n, useV) {
      for (var i = 0; i < n; i++) { var p = list[i % list.length]; add(p[useV], 1, useV === 'v8' ? 8 : 1, p.name); }
    }

    var gels = GELS.filter(function (g) { return ok(g.v1) && (!g.caffeine || minutes >= 90); });
    var ultras = ULTRAS.filter(function (u) { return ok(u.v1) || ok(u.v8); });
    var bars = BARS.filter(function (b) { return ok(b.v1); });

    var need = { gel: units.gel * multiplier, ultra: units.ultra * multiplier, bar: units.bar * multiplier };
    if (!ultras.length) { need.gel += Math.ceil(need.ultra * 62.5 / 25.4); need.ultra = 0; }
    if (!bars.length)   { need.gel += Math.ceil(need.bar * 23.5 / 25.4);   need.bar = 0; }

    if (need.gel) {
      var gp = [{ units: 1, price: 52000 }];
      if (gels.length) gp[0].price = price(gels[0].v1);
      if (ok(GEL_VARIETY.v)) gp.push({ units: 12, price: price(GEL_VARIETY.v) });
      var gc = cheapest(need.gel, gp);
      if (gc[1]) add(GEL_VARIETY.v, gc[1], 12, GEL_VARIETY.name);
      rotate(gels.length ? gels : GELS, gc[0], 'v1');
    }
    if (need.ultra) {
      var u1 = ultras.filter(function (u) { return ok(u.v1); });
      var u8 = ultras.filter(function (u) { return ok(u.v8); });
      var up = [];
      if (u1.length) up.push({ units: 1, price: price(u1[0].v1), list: u1, key: 'v1' });
      if (u8.length) up.push({ units: 8, price: price(u8[0].v8), list: u8, key: 'v8' });
      var uc = cheapest(need.ultra, up);
      up.forEach(function (p, i) { rotate(p.list, uc[i], p.key); });
    }
    if (need.bar) {
      var bp = [{ units: 1, price: price(bars[0].v1) }];
      if (ok(BAR_VARIETY.v)) bp.push({ units: 12, price: price(BAR_VARIETY.v) });
      var bc = cheapest(need.bar, bp);
      if (bc[1]) add(BAR_VARIETY.v, bc[1], 12, BAR_VARIETY.name);
      rotate(bars, bc[0], 'v1');
    }

    var list = Object.keys(lines).map(function (k) { return lines[k]; });
    var total = list.reduce(function (s, l) { return s + l.qty * price(l.v); }, 0);
    var got = list.reduce(function (s, l) { return s + l.units; }, 0);
    var needed = need.gel + need.ultra + need.bar;
    return { lines: list, total: total, spare: Math.max(0, got - needed) };
  }

  // Sodium from the race-day units only (average per product type)
  function sodiumCovered(units) {
    function avg(list) { return list.reduce(function (s, p) { return s + p.na; }, 0) / list.length; }
    return Math.round(units.gel * avg(GELS) + units.ultra * avg(ULTRAS) + units.bar * avg(BARS));
  }

  var CALC = { targets: targets, raceUnits: raceUnits, buildKit: buildKit, sodiumCovered: sodiumCovered,
               cheapest: cheapest, RACES: RACES, GOALS: GOALS };
  /* calc:end */

  /* ── Helpers ──────────────────────────────────────────────────────────── */
  function live(v) {
    var d = DATA.variants[v];
    return d ? { p: d.p / 100, a: d.a, t: d.t, i: d.i } : null;
  }
  var nf = new Intl.NumberFormat(LANG === 'vi' ? 'vi-VN' : 'en-US', {
    style: 'currency', currency: DATA.currency, maximumFractionDigits: DATA.currency === 'VND' ? 0 : 2
  });
  function money(x) { return nf.format(Math.round(x)); }
  function num(x) { return new Intl.NumberFormat(LANG === 'vi' ? 'vi-VN' : 'en-US').format(x); }
  function hm(m) { return Math.floor(m / 60) + ':' + ('0' + (m % 60)).slice(-2); }
  function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
  function half(x) { var r = Math.round(x * 2) / 2; return r === 0.5 ? '½' : String(r).replace('.5', '½'); }
  function track(name, extra) {
    var payload = Object.assign({ race: st.race, goal: st.goal, sweat: st.sweat, minutes: st.minutes, kit: st.kit }, extra || {});
    try { if (window.Shopify && Shopify.analytics && Shopify.analytics.publish) Shopify.analytics.publish('lecka_race_quiz_' + name, payload); } catch (e) {}
    try { (window.dataLayer = window.dataLayer || []).push(Object.assign({ event: 'lecka_race_quiz_' + name }, payload)); } catch (e) {}
  }

  /* ── State & render ───────────────────────────────────────────────────── */
  var st = { step: 1, race: null, goal: null, sweat: null, minutes: 0, kit: S.defaultKit === 'training' ? 'training' : 'race' };

  function dots(n) {
    return '<span class="lrq-dots">' + [1, 2, 3].map(function (i) { return '<i class="' + (i <= n ? 'on' : '') + '"></i>'; }).join('') + '</span>';
  }
  function head(step, title, sub) {
    return '<p class="lrq-eyebrow"><span>' + esc(t('eyebrow')) + '</span>' + dots(step) + '</p>' +
      '<h2>' + esc(title) + '</h2>' + (sub ? '<p class="lrq-sub">' + esc(sub) + '</p>' : '');
  }
  function chip(action, value, label, sub, on) {
    return '<button type="button" class="lrq-chip' + (on ? ' on' : '') + '" data-a="' + action + '" data-v="' + value + '">' +
      '<b>' + esc(label) + '</b>' + (sub ? '<small>' + esc(sub) + '</small>' : '') + '</button>';
  }
  function back() { return '<button type="button" class="lrq-back" data-a="back">' + esc(t('back')) + '</button>'; }

  function render() {
    var h = '';
    if (st.step === 1) {
      h = head(1, t('q1'), t('q1sub')) + '<div class="lrq-grid">' + RACE_ORDER.map(function (r) {
        return chip('race', r, t('race_' + r), t('race_' + r + '_s'), st.race === r);
      }).join('') + '</div>';
    } else if (st.step === 2) {
      h = head(2, t('q2'), t('q2sub')) + '<div class="lrq-grid one three">' + GOALS.map(function (g, i) {
        return chip('goal', g, t('goal_' + g), t('goal_' + g + '_s') + ' · ~' + hm(RACES[st.race].min[i]), st.goal === g);
      }).join('') + '</div>' + back();
    } else if (st.step === 3) {
      h = head(3, t('q3'), t('q3sub')) + '<div class="lrq-grid">' + ['light', 'average', 'salty', 'unsure'].map(function (s) {
        return chip('sweat', s, t('sweat_' + s), t('sweat_' + s + '_s'), st.sweat === s);
      }).join('') + '</div>' + back();
    } else {
      h = renderResult();
    }
    root.innerHTML = h;
  }

  function renderResult() {
    var sweat = st.sweat === 'unsure' ? 'average' : st.sweat;
    var tg = CALC.targets(st.race, st.goal, st.minutes, sweat);
    var units = CALC.raceUnits(st.race, tg);
    var kit = CALC.buildKit(st.race, units, st.kit === 'training' ? 3 : 1, st.minutes, live);
    var raceKit = st.kit === 'race' ? kit : CALC.buildKit(st.race, units, 1, st.minutes, live);
    st.lines = kit.lines;

    var how;
    if (st.minutes < 60) how = t('shortRace');
    else if (!units.ultra && !units.bar) how = t('every', { min: Math.max(10, Math.round(st.minutes / units.gel / 5) * 5) });
    else {
      var parts = [];
      [['gel', units.gel], ['ultra', units.ultra], ['bar', units.bar]].forEach(function (p) {
        if (p[1]) parts.push('~' + half(p[1] / tg.hours) + ' ' + t(p[0]));
      });
      how = t('perHour', { list: parts.join(t('and')) });
    }

    var covered = Math.min(CALC.sodiumCovered(units), tg.sodium);
    var pct = tg.sodium ? Math.round(covered / tg.sodium * 100) : 100;
    var gap = tg.sodium - covered;
    var na = gap <= tg.sodium * 0.05
      ? '<p style="margin:0">' + esc(t('naFull', { need: num(tg.sodium) })) + '</p>'
      : '<p style="margin:0">' + esc(t('naCovered', { mg: num(covered), need: num(tg.sodium) })) + '</p>' +
        '<div class="lrq-bar"><i style="width:' + pct + '%"></i></div>' +
        '<p style="margin:0">' + esc(t('naGap', { gap: num(Math.round(gap / 10) * 10), gapH: num(Math.round(gap / tg.hours / 10) * 10) })) +
        ' <strong>' + esc(t('naSoon')) + '</strong><span class="lrq-soon">' + esc(t('soon')) + '</span></p>';

    var items = kit.lines.map(function (l) {
      var d = live(l.v), title = d && d.t ? d.t : l.name;
      var sub = l.units !== l.qty ? l.units + ' ' + (LANG === 'vi' ? 'gói' : 'pcs') : '';
      return '<li>' + (d && d.i ? '<img src="' + esc(d.i) + '" alt="" loading="lazy" width="48" height="48">' : '') +
        '<span class="n">' + l.qty + ' ' + t('x') + ' ' + esc(title) + (sub ? '<small>' + esc(sub) + '</small>' : '') + '</span>' +
        '<span>' + money(l.qty * (d ? d.p : FALLBACK_PRICE[l.v])) + '</span></li>';
    }).join('');

    var pctOff = S.discountCode && S.discountPct > 0 ? S.discountPct : 0;
    var pay = kit.total * (1 - pctOff / 100);
    var cartNow = DATA.cartTotal / 100;
    var ship = '';
    if (S.freeShipping > 0) {
      var left = S.freeShipping - (cartNow + pay);
      ship = '<p class="lrq-ship">' + esc(left <= 0 ? t('shipFree') : t('shipMore', { amt: money(left) })) + '</p>';
    }
    var raceUnitsCount = raceKit.lines.reduce(function (s, l) { return s + l.units; }, 0);

    return '<p class="lrq-eyebrow"><span>' + esc(t('eyebrow')) + '</span>' + dots(3) + '</p>' +
      '<h2>' + esc(t('result', { race: t('race_' + st.race) })) + '</h2>' +
      '<div class="lrq-assume"><span class="lrq-time">' + esc(t('finish')) +
        ' <button type="button" data-a="time" data-v="-1" aria-label="−">−</button><strong>' + hm(st.minutes) +
        '</strong><button type="button" data-a="time" data-v="1" aria-label="+">+</button></span>' +
        '<span>· ' + esc(t('goal_' + st.goal)) + ' · ' + esc(t('climate')) + '</span></div>' +
      '<div class="lrq-stats">' +
        '<div class="lrq-stat"><b>' + tg.carbH + '<small> g</small></b><span>' + esc(t('carbs')) + '</span></div>' +
        '<div class="lrq-stat"><b>' + num(tg.naH) + '<small> mg</small></b><span>' + esc(t('sodium')) + '</span></div>' +
        '<div class="lrq-stat"><b>' + num(tg.fluidH) + '<small> ml</small></b><span>' + esc(t('fluid')) + '</span></div>' +
      '</div>' +
      '<p class="lrq-how">' + esc(how) + '<br><small class="lrq-note">' + esc(t('total', { carbs: num(tg.carbs), sodium: num(tg.sodium) })) + '</small></p>' +
      '<div class="lrq-sodium">' + na + '</div>' +
      '<h3>' + esc(t('kitTitle')) + '</h3>' +
      '<div class="lrq-tabs">' +
        chip('kit', 'race', t('kitRace'), t('kitRace_s', { n: raceUnitsCount }), st.kit === 'race') +
        chip('kit', 'training', t('kitTrain'), t('kitTrain_s'), st.kit === 'training') +
      '</div>' +
      '<ul class="lrq-items">' + items + '</ul>' +
      (kit.spare ? '<p class="lrq-note">+ ' + esc(t('spare', { n: kit.spare })) + '</p>' : '') +
      '<div class="lrq-total' + (pctOff ? '' : ' big') + '"><span>' + esc(t('subtotal')) + '</span><span>' + money(kit.total) + '</span></div>' +
      (pctOff ? '<div class="lrq-total big"><span>' + esc(t('youPay')) + '</span><span>' + money(pay) + '</span></div>' +
        '<p class="lrq-note" style="margin:0">' + esc(t('youPayNote', { pct: pctOff, code: S.discountCode })) + '</p>' : '') +
      ship +
      '<button type="button" class="lrq-cta" data-a="checkout">' + esc(t('cta')) + '</button>' +
      '<p class="lrq-err" data-lrq-err hidden>' + esc(t('err')) + '</p>' +
      '<div class="lrq-links">' +
        '<button type="button" data-a="cart">' + esc(t('cartOnly')) + '</button>' +
        (S.plannerUrl ? '<a class="plan" href="' + esc(plannerLink()) + '" target="_blank" rel="noopener" data-a="plan">' + esc(t('fullPlan')) + '</a>' : '') +
      '</div>' +
      '<p class="lrq-fine">' + esc(t('fine')) + '</p>' +
      back();
  }

  function plannerLink() {
    var q = {
      region: S.region, lang: LANG, race: st.race, time: st.minutes, effort: st.goal,
      climate: 'humid', utm_source: location.hostname, utm_medium: 'race_quiz', utm_campaign: st.race
    };
    if (st.sweat && st.sweat !== 'unsure') q.sweat = st.sweat;
    if (RACES[st.race].km) q.km = RACES[st.race].km;
    return S.plannerUrl.replace(/\/+$/, '') + '/planner/pro?' +
      Object.keys(q).map(function (k) { return k + '=' + encodeURIComponent(q[k]); }).join('&');
  }

  function addToCart(then) {
    var btns = root.querySelectorAll('[data-a="checkout"],[data-a="cart"]');
    btns.forEach(function (b) { b.disabled = true; });
    var cta = root.querySelector('[data-a="checkout"]');
    if (cta) cta.textContent = t('ctaBusy');
    var note = t('race_' + st.race) + ' · ' + hm(st.minutes) + ' · ' + st.goal + ' · ' + (st.sweat || '');
    fetch(DATA.cartAdd + '.js', {
      method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ items: st.lines.map(function (l) { return { id: l.v, quantity: l.qty }; }) })
    }).then(function (r) {
      if (!r.ok) throw new Error('cart ' + r.status);
      return fetch(DATA.cartUrl + '/update.js', {
        method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ attributes: { 'Race quiz': note } })
      }).catch(function () {});
    }).then(then).catch(function () {
      btns.forEach(function (b) { b.disabled = false; });
      if (cta) cta.textContent = t('cta');
      var e = root.querySelector('[data-lrq-err]'); if (e) e.hidden = false;
    });
  }

  function go(path) {
    // /discount/CODE stores the code for checkout, then redirects
    var code = S.discountCode;
    location.href = code
      ? '/discount/' + encodeURIComponent(code) + '?redirect=' + encodeURIComponent(path)
      : path;
  }

  root.addEventListener('click', function (e) {
    var el = e.target.closest('[data-a]');
    if (!el) return;
    var a = el.getAttribute('data-a'), v = el.getAttribute('data-v');
    if (a === 'race') { st.race = v; st.step = 2; track('race'); }
    else if (a === 'goal') { st.goal = v; st.minutes = RACES[st.race].min[GOALS.indexOf(v)]; st.step = 3; }
    else if (a === 'sweat') { st.sweat = v; st.step = 4; track('result'); }
    else if (a === 'back') { st.step = Math.max(1, st.step - 1); }
    else if (a === 'time') {
      var step = st.minutes < 120 ? 5 : 15;
      st.minutes = Math.min(1200, Math.max(30, st.minutes + step * Number(v)));
    }
    else if (a === 'kit') { st.kit = v; track('kit'); }
    else if (a === 'checkout') { track('checkout'); addToCart(function () { go('/checkout'); }); return; }
    else if (a === 'cart') { track('add_to_cart'); addToCart(function () { go(DATA.cartUrl); }); return; }
    else if (a === 'plan') { track('full_plan'); return; }
    else return;
    render();
    if (a !== 'time' && a !== 'kit') {
      var top = host.getBoundingClientRect().top;
      if (top < 0) host.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  });

  render();
  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function (en) {
      if (en[0].isIntersecting) { track('view'); io.disconnect(); }
    }, { threshold: 0.4 });
    io.observe(host);
  }
})();
</script>

{% schema %}
{
  "name": "Race Fuel Quiz",
  "tag": "div",
  "class": "section-race-fuel-quiz",
  "settings": [
    { "type": "header", "content": "Checkout" },
    {
      "type": "text", "id": "discount_code", "label": "Discount code", "default": "RACEKIT5",
      "info": "Create this code under Discounts first. Leave empty for no discount."
    },
    {
      "type": "range", "id": "discount_percent", "label": "Discount shown in the quiz",
      "min": 0, "max": 30, "step": 1, "unit": "%", "default": 5,
      "info": "Only for display. The real discount is the code above."
    },
    {
      "type": "number", "id": "free_shipping_threshold", "label": "Free shipping from (store currency)",
      "default": 300000, "info": "0 hides the free shipping line."
    },
    {
      "type": "select", "id": "default_kit", "label": "Kit selected first", "default": "race",
      "options": [
        { "value": "race", "label": "Race day" },
        { "value": "training", "label": "Race + 2 training runs" }
      ]
    },
    { "type": "header", "content": "Full planner link" },
    {
      "type": "text", "id": "planner_url", "label": "Planner URL", "default": "https://plan.getlecka.com",
      "info": "No trailing slash. Leave empty to hide the link."
    },
    {
      "type": "select", "id": "region", "label": "Planner region", "default": "vn",
      "options": [
        { "value": "vn", "label": "Vietnam" },
        { "value": "us", "label": "United States" },
        { "value": "de", "label": "Germany" },
        { "value": "dk", "label": "Denmark" },
        { "value": "ch", "label": "Switzerland" }
      ]
    },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "color_bg", "label": "Section background", "default": "#F5F4F1" },
    { "type": "color", "id": "color_card", "label": "Card background", "default": "#FFFFFF" },
    { "type": "color", "id": "color_text", "label": "Text", "default": "#1B1B1B" },
    { "type": "color", "id": "color_accent", "label": "Accent", "default": "#48C4B0" },
    { "type": "color", "id": "color_button", "label": "Button", "default": "#1B1B1B" },
    { "type": "color", "id": "color_button_text", "label": "Button text", "default": "#FFFFFF" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom", "default": 40 }
  ],
  "presets": [{ "name": "Race Fuel Quiz" }]
}
